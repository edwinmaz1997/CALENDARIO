DirectoryIndex index.php
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Bloquear acceso directo a carpetas internas
  RewriteRule ^(includes|config|sql|lib|cron|uploads/adjuntos)(/|$) - [F,L]
  # Bloquear archivos ocultos (.git, .env, etc.)
  RewriteRule (^|/)\. - [F,L]
</IfModule>

<FilesMatch "\.(sql|md|log|ini|example\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
